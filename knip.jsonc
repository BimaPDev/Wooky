{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": { "entry": ["scripts/*.mjs"] },
    "apps/web": { "entry": ["index.html"] },
    "apps/desktop": { "entry": ["src/main.ts", "src/preload.ts"] },
  },
  "ignoreExportsUsedInFile": true,
  // The brain hardening test makes a FIFO with the system mkfifo; Node has no API for it.
  "ignoreBinaries": ["mkfifo"],
}
